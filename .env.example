# Optional environment settings; this template is not loaded automatically.
# Server/bootstrap.sh reads the first five values in the Kaggle environment.
MODEL_REPO=
HF_TOKEN=
QWENFREE_API_KEY=
CTX_SIZE=8192
NGROK_AUTHTOKEN=

# Optional explicit selection for `qwenfree local pull`; no model is defaulted.
QWENFREE_LOCAL_REPO=
QWENFREE_LOCAL_FILE=
# Only needed when Hugging Face metadata omits parameter count. Verify the card.
QWENFREE_LOCAL_PARAMS_BILLIONS=
QWENFREE_LOCAL_PORT=8081

# Client-side completion cap for Cloudflare's non-streaming tunnel path.
QWENFREE_MAX_TOKENS=512
